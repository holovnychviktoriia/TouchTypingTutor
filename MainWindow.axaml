<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="TouchTypingTutor.MainWindow"
        Title="Touch Typing Tutor"
        Width="900" Height="600"
        MinWidth="700" MinHeight="500">

    <Grid ColumnDefinitions="200,*">

        <Border Grid.Column="0" Background="{DynamicResource SidebarBrush}">
            <StackPanel Margin="10">
                <TextBlock Text="Головнич Вікторія КН-21"
                           FontSize="13"
                           Margin="8,15,5,0"
                           Opacity="0.7"
                           TextDecorations="Underline"/>

                <TextBlock Text="Touch Typing"
                           FontSize="18" FontWeight="Bold"
                           Margin="8,10,5,5"/>
                <TextBlock Text="Tutor"
                           FontSize="18" FontWeight="Bold"
                           Margin="8,0,5,25"
                           Foreground="{DynamicResource AccentBrush}"/>

                <Button x:Name="HomeButton" Classes="nav" Click="OnHomeClick"/>
                <Button x:Name="LessonsButton" Classes="nav" Click="OnLessonsClick"/>
                <Button x:Name="TypingButton" Classes="nav" Click="OnTypingClick"/>
                <Button x:Name="SettingsButton" Classes="nav" Click="OnSettingsClick"/>
            </StackPanel>
        </Border>

        <ContentControl Grid.Column="1" x:Name="ContentArea" Margin="20"/>

    </Grid>
</Window>
