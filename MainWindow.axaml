<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="TouchTypingTutor.MainWindow"
        Title="Touch Typing Tutor"
        Width="900" Height="600"
        MinWidth="700" MinHeight="500"
        RequestedThemeVariant="Light">

    <Grid ColumnDefinitions="200,*">

        <Border Grid.Column="0" Background="{StaticResource SidebarBrush}">
            <StackPanel Margin="10">
                <TextBlock Text="Touch Typing"
                           FontSize="18" FontWeight="Bold"
                           Margin="8,15,5,5"/>
                <TextBlock Text="Tutor"
                           FontSize="18" FontWeight="Bold"
                           Margin="8,0,5,25"
                           Foreground="{StaticResource AccentBrush}"/>

                <Button x:Name="HomeButton" Content="Головна"
                        Classes="nav" Click="OnHomeClick"/>
                <Button x:Name="LessonsButton" Content="Уроки"
                        Classes="nav" Click="OnLessonsClick"/>
                <Button x:Name="TypingButton" Content="Тренування"
                        Classes="nav" Click="OnTypingClick"/>
                <Button x:Name="SettingsButton" Content="Налаштування"
                        Classes="nav" Click="OnSettingsClick"/>
            </StackPanel>
        </Border>

        <ContentControl Grid.Column="1" x:Name="ContentArea" Margin="20"/>

    </Grid>
</Window>
