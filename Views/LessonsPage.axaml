<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="using:TouchTypingTutor.Models"
             x:Class="TouchTypingTutor.Views.LessonsPage">

  <Grid RowDefinitions="Auto,*" ColumnDefinitions="280,*">

    <TextBlock x:Name="TitleText" Grid.Row="0" Grid.ColumnSpan="2"
               FontSize="28" FontWeight="Bold"
               Margin="10,0,0,20"/>

    <!-- Ліва частина: список уроків -->
    <Border Grid.Row="1" Grid.Column="0"
            BorderBrush="#E0E0E8" BorderThickness="1"
            CornerRadius="6" Padding="10">
      <Grid RowDefinitions="*,Auto">

        <ListBox Grid.Row="0" x:Name="LessonsList"
                 SelectionChanged="OnLessonSelected">
          <ListBox.ItemTemplate>
            <DataTemplate DataType="models:Lesson">
              <StackPanel Margin="0,3">
                <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding Difficulty}"
                           FontSize="11" Foreground="Gray"/>
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <Button x:Name="AddButton" Grid.Row="1"
                Margin="0,10,0,0"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center"
                Click="OnAddClick"/>

      </Grid>
    </Border>

    <!-- Права частина: форма редагування -->
    <ScrollViewer Grid.Row="1" Grid.Column="1" Margin="15,0,0,0">
      <StackPanel x:Name="EditPanel" Spacing="10">

        <TextBlock x:Name="NameLabel" FontWeight="SemiBold"/>
        <TextBox x:Name="TitleBox"/>

        <TextBlock x:Name="DifficultyLabel" FontWeight="SemiBold" Margin="0,10,0,0"/>
        <ComboBox x:Name="DifficultyBox" HorizontalAlignment="Stretch">
          <ComboBoxItem Content="Легкий"/>
          <ComboBoxItem Content="Середній"/>
          <ComboBoxItem Content="Складний"/>
        </ComboBox>

        <TextBlock x:Name="TextLabel" FontWeight="SemiBold" Margin="0,10,0,0"/>
        <TextBox x:Name="TextBox"
                 AcceptsReturn="True" TextWrapping="Wrap"
                 MinHeight="120"/>

        <TextBlock x:Name="ErrorText" Foreground="#D33B3B" Margin="0,5,0,0"/>

        <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,15,0,0">
          <Button x:Name="SaveButton" Click="OnSaveClick"
                  Background="{DynamicResource AccentBrush}"
                  Foreground="White"
                  Padding="20,8"/>
          <Button x:Name="DeleteButton"
                  Click="OnDeleteClick"
                  Padding="20,8"
                  IsEnabled="False"/>
        </StackPanel>

      </StackPanel>
    </ScrollViewer>

  </Grid>

</UserControl>
