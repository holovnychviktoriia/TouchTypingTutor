<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="TouchTypingTutor.Views.SettingsPage">

  <StackPanel Margin="10" Spacing="20">

    <TextBlock x:Name="TitleText"
               FontSize="28" FontWeight="Bold"/>

    <!-- Мова -->
    <StackPanel Spacing="8">
      <TextBlock x:Name="LanguageLabel" FontWeight="SemiBold"/>
      <ComboBox x:Name="LanguageBox" Width="200"
                SelectionChanged="OnLanguageChanged">
        <ComboBoxItem Content="Українська" Tag="uk"/>
        <ComboBoxItem Content="English" Tag="en"/>
      </ComboBox>
    </StackPanel>

    <!-- Тема -->
    <StackPanel Spacing="8">
      <TextBlock x:Name="ThemeLabel" FontWeight="SemiBold"/>
      <ComboBox x:Name="ThemeBox" Width="200"
                SelectionChanged="OnThemeChanged">
        <ComboBoxItem x:Name="LightItem" Tag="Light"/>
        <ComboBoxItem x:Name="DarkItem" Tag="Dark"/>
      </ComboBox>
    </StackPanel>

  </StackPanel>

</UserControl>
