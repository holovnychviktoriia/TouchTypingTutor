<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="using:TouchTypingTutor.Models"
             x:Class="TouchTypingTutor.Views.HomePage">

  <ScrollViewer>
    <StackPanel Margin="10" Spacing="20">

      <TextBlock x:Name="TitleText" FontSize="28" FontWeight="Bold"/>
      <TextBlock x:Name="WelcomeText" FontSize="16" Foreground="Gray"/>

      <!-- Загальна статистика -->
      <Border BorderBrush="#E0E0E8" BorderThickness="1"
              CornerRadius="6" Padding="15">
        <Grid ColumnDefinitions="*,*,*">
          <StackPanel Grid.Column="0" HorizontalAlignment="Center">
            <TextBlock x:Name="TotalCaption" FontSize="12" Foreground="Gray"
                       HorizontalAlignment="Center"/>
            <TextBlock x:Name="TotalLabel" Text="0"
                       FontSize="26" FontWeight="Bold"
                       HorizontalAlignment="Center"/>
          </StackPanel>
          <StackPanel Grid.Column="1" HorizontalAlignment="Center">
            <TextBlock x:Name="AvgWpmCaption" FontSize="12" Foreground="Gray"
                       HorizontalAlignment="Center"/>
            <TextBlock x:Name="AvgWpmLabel" Text="—"
                       FontSize="26" FontWeight="Bold"
                       HorizontalAlignment="Center"/>
          </StackPanel>
          <StackPanel Grid.Column="2" HorizontalAlignment="Center">
            <TextBlock x:Name="AvgAccCaption" FontSize="12" Foreground="Gray"
                       HorizontalAlignment="Center"/>
            <TextBlock x:Name="AvgAccLabel" Text="—"
                       FontSize="26" FontWeight="Bold"
                       HorizontalAlignment="Center"/>
          </StackPanel>
        </Grid>
      </Border>

      <TextBlock x:Name="ChartTitleText" FontSize="16" FontWeight="SemiBold"/>
      <Border BorderBrush="#E0E0E8" BorderThickness="1"
              CornerRadius="6" Padding="15"
              Height="220">
        <Canvas x:Name="ChartCanvas" Background="Transparent"/>
      </Border>

      <TextBlock x:Name="RecentTitleText" FontSize="16" FontWeight="SemiBold"/>
      <Border BorderBrush="#E0E0E8" BorderThickness="1"
              CornerRadius="6" Padding="10">
        <ItemsControl x:Name="RecentList">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="models:ResultRow">
              <Grid ColumnDefinitions="*,Auto,Auto,Auto" Margin="5">
                <TextBlock Grid.Column="0"
                           Text="{Binding LessonTitle}"
                           VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1"
                           Text="{Binding DateText}"
                           Margin="10,0"
                           Foreground="Gray"
                           VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2"
                           Text="{Binding WpmText}"
                           Margin="10,0"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
                <TextBlock Grid.Column="3"
                           Text="{Binding AccText}"
                           Margin="10,0"
                           Foreground="#5B6CFF"
                           VerticalAlignment="Center"/>
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Border>

      <TextBlock x:Name="EmptyText"
                 Foreground="Gray" FontStyle="Italic"
                 IsVisible="False"/>

    </StackPanel>
  </ScrollViewer>

</UserControl>
