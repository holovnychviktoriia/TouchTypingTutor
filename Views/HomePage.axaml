<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="TouchTypingTutor.Views.HomePage">

  <StackPanel Margin="10">
    <TextBlock Text="Головна" FontSize="28" FontWeight="Bold"/>
    <TextBlock Text="Ласкаво просимо до Touch Typing Tutor!"
               Margin="0,15,0,0" FontSize="16"/>
    <TextBlock Text="Тут буде відображатися статистика та графік прогресу."
               Margin="0,5,0,0" FontSize="14" Foreground="Gray"/>
  </StackPanel>

</UserControl>
